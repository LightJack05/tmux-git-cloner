# tmux-git-cloner configuration file
# 
# Copy this file to ~/.config/tmux-git-cloner/config and customize as needed.
#
# CLONE_DIR: Directory where repositories will be cloned
#
# Remote configuration:
# This tool uses gh (GitHub CLI), tea (Gitea CLI) and glab (GitLab CLI) for
# authentication. No tokens need to be configured here - use the respective
# CLI tools to authenticate:
#   - GitHub: gh auth login
#   - Gitea:  tea login add
#   - GitLab: glab auth login
#
# REMOTES: Space-separated list of remotes to query
# Format: type:host:protocol
# Type can be 'github', 'gitea' or 'gitlab'
# Protocol can be 'ssh' or 'https'
# Examples:
#   github:github.com:ssh
#   github:github.mycompany.com:https  (GitHub Enterprise)
#   gitea:gitea.example.com:ssh
#   gitlab:gitlab.com:ssh
#   gitlab:gitlab.mycompany.com:https  (self-managed GitLab)

CLONE_DIR="${HOME}/repos"

# List of remotes to query (space-separated)
# Format: type:host:protocol
REMOTES="github:github.com:https"

# Example with multiple remotes:
# REMOTES="github:github.com:ssh github:github.company.com:https gitea:git.mydomain.com:ssh gitlab:gitlab.com:ssh"
